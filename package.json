{
  "name": "@cookie-ja/monorepo",
  "version": "0.1.0",
  "description": "Cookie consent management library for Japanese legal compliance (APPI/GDPR)",
  "type": "module",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "packages/*",
    "apps/*",
    "edge/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "prepare": "husky"
  },
  "keywords": [
    "cookie",
    "consent",
    "gdpr",
    "appi",
    "privacy",
    "japan",
    "react",
    "nextjs",
    "vue",
    "wordpress",
    "typescript"
  ],
  "author": "Sakamoto T.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LibraZeroX/cookie-consent-app.git"
  },
  "bugs": {
    "url": "https://github.com/LibraZeroX/cookie-consent-app/issues"
  },
  "homepage": "https://github.com/LibraZeroX/cookie-consent-app#readme",
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "tsup": "^8.0.0",
    "turbo": "*",
    "typescript": "^5.0.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  }
}
